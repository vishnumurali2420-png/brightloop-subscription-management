<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Subscription Sequence -->
        <record id="seq_brightloop_subscription" model="ir.sequence">
            <field name="name">Brightloop Subscription</field>
            <field name="code">brightloop.subscription</field>
            <field name="prefix">SUB/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Payment Sequence -->
        <record id="seq_brightloop_payment" model="ir.sequence">
            <field name="name">Brightloop Payment</field>
            <field name="code">brightloop.payment</field>
            <field name="prefix">PAY/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Discount Product Placeholder -->
        <record id="product_subscription_discount" model="product.product">
            <field name="name">Subscription Discount</field>
            <field name="type">service</field>
            <field name="default_code">DISC-SUB</field>
            <field name="list_price">0.0</field>
            <field name="standard_price">0.0</field>
        </record>
    </data>
</odoo>
