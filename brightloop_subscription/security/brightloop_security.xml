<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_brightloop_subscription">
        <field name="name">Brightloop Subscription Management</field>
        <field name="description">User access levels for Brightloop Subscription ERP</field>
        <field name="sequence">20</field>
    </record>

    <!-- Groups -->
    <record id="group_brightloop_staff" model="res.groups">
        <field name="name">Staff / Sales Operations</field>
        <field name="category_id" ref="module_category_brightloop_subscription"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_brightloop_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_brightloop_subscription"/>
        <field name="implied_ids" eval="[(4, ref('group_brightloop_staff'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="rule_subscription_portal_user" model="ir.rule">
        <field name="name">Portal Customer: View Only Own Subscriptions</field>
        <field name="model_id" ref="model_brightloop_subscription"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_subscription_staff_user" model="ir.rule">
        <field name="name">Staff: Manage Assigned or All Company Subscriptions</field>
        <field name="model_id" ref="model_brightloop_subscription"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_brightloop_staff'))]"/>
    </record>

    <record id="rule_payment_portal_user" model="ir.rule">
        <field name="name">Portal Customer: View Only Own Payments</field>
        <field name="model_id" ref="model_brightloop_payment"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
