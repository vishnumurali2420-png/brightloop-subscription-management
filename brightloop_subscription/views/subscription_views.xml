<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_brightloop_subscription_tree" model="ir.ui.view">
        <field name="name">brightloop.subscription.tree</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <tree string="Subscriptions" decoration-success="status == 'active'" decoration-warning="status == 'paused'" decoration-danger="status == 'expired'" decoration-muted="status == 'closed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="start_date"/>
                <field name="expiry_date"/>
                <field name="next_billing_date"/>
                <field name="amount_total" sum="Total"/>
                <field name="status" widget="badge" 
                       decoration-success="status == 'active'" 
                       decoration-warning="status == 'paused'" 
                       decoration-danger="status in ('expired', 'closed')" 
                       decoration-info="status in ('draft', 'quotation', 'confirmed')"/>
            </tree>
        </field>
    </record>

    <record id="view_brightloop_subscription_form" model="ir.ui.view">
        <field name="name">brightloop.subscription.form</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_to_quotation" string="Send Quotation" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="status != 'quotation'"/>
                    <button name="action_activate" string="Activate Subscription" type="object" class="btn-success" invisible="status not in ('confirmed', 'draft')"/>
                    <button name="generate_recurring_invoice" string="Generate Invoice Now" type="object" class="btn-primary" invisible="status != 'active'"/>
                    <button name="action_pause" string="Pause" type="object" invisible="status != 'active'"/>
                    <button name="action_resume" string="Resume" type="object" class="btn-info" invisible="status != 'paused'"/>
                    <button name="action_renew" string="Renew Plan" type="object" class="btn-secondary" invisible="status not in ('active', 'expired')"/>
                    <button name="action_close" string="Cancel / Close" type="object" invisible="status in ('closed', 'expired')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,quotation,confirmed,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_invoices" icon="fa-pencil-square-o">
                            <field string="Invoices" name="invoice_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Customer &amp; Terms">
                            <field name="partner_id"/>
                            <field name="plan_id"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Billing Dates &amp; Discount">
                            <field name="start_date"/>
                            <field name="expiry_date"/>
                            <field name="next_billing_date"/>
                            <field name="payment_terms_id"/>
                            <field name="discount_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subscription Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="subtotal"/>
                                    <field name="total_amount"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_discount" invisible="amount_discount == 0"/>
                                <div class="oe_subtotal_footer_separator oe_inline">
                                    <label for="amount_total"/>
                                </div>
                                <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Invoices Generated">
                            <field name="invoice_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total"/>
                                    <field name="amount_residual" string="Outstanding"/>
                                    <field name="payment_state" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_brightloop_subscriptions" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">brightloop.subscription</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
