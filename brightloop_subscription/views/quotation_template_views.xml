<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_brightloop_quotation_template_tree" model="ir.ui.view">
        <field name="name">brightloop.quotation.template.tree</field>
        <field name="model">brightloop.quotation.template</field>
        <field name="arch" type="xml">
            <tree string="Quotation Templates">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="validity_days"/>
            </tree>
        </field>
    </record>

    <record id="view_brightloop_quotation_template_form" model="ir.ui.view">
        <field name="name">brightloop.quotation.template.form</field>
        <field name="model">brightloop.quotation.template</field>
        <field name="arch" type="xml">
            <form string="Quotation Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Standard SaaS Startup Quote"/></h1>
                    </div>
                    <group>
                        <field name="plan_id"/>
                        <field name="validity_days"/>
                    </group>
                    <notebook>
                        <page string="Predefined Products">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_brightloop_quotation_templates" model="ir.actions.act_window">
        <field name="name">Quotation Templates</field>
        <field name="res_model">brightloop.quotation.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Filtered view for Quotation stage subscriptions -->
    <record id="action_brightloop_quotations" model="ir.actions.act_window">
        <field name="name">Subscription Quotations</field>
        <field name="res_model">brightloop.subscription</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('status', 'in', ('draft', 'quotation'))]</field>
        <field name="context">{'default_status': 'draft'}</field>
    </record>
</odoo>
