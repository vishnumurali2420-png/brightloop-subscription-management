<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_brightloop_subscription_plan_tree" model="ir.ui.view">
        <field name="name">brightloop.subscription.plan.tree</field>
        <field name="model">brightloop.subscription.plan</field>
        <field name="arch" type="xml">
            <tree string="Subscription Plans" decoration-muted="status == 'archived'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="billing_frequency"/>
                <field name="price"/>
                <field name="min_quantity"/>
                <field name="auto_renewal"/>
                <field name="allow_pause"/>
                <field name="allow_early_cancellation"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-info="status == 'draft'"/>
            </tree>
        </field>
    </record>

    <record id="view_brightloop_subscription_plan_form" model="ir.ui.view">
        <field name="name">brightloop.subscription.plan.form</field>
        <field name="model">brightloop.subscription.plan</field>
        <field name="arch" type="xml">
            <form string="Subscription Plan">
                <header>
                    <button name="action_activate" string="Activate Plan" type="object" class="oe_highlight" invisible="status == 'active'"/>
                    <button name="action_archive" string="Archive Plan" type="object" invisible="status == 'archived'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Enterprise Monthly Plan"/></h1>
                    </div>
                    <group>
                        <group string="Product &amp; Pricing">
                            <field name="product_id"/>
                            <field name="price"/>
                            <field name="billing_frequency"/>
                            <field name="billing_interval"/>
                            <field name="min_quantity"/>
                        </group>
                        <group string="Schedule &amp; Policies">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="auto_renewal"/>
                            <field name="allow_pause"/>
                            <field name="allow_early_cancellation"/>
                            <field name="auto_close_on_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description &amp; Terms">
                            <field name="description" placeholder="Specify features included in this plan..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_brightloop_plans" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">brightloop.subscription.plan</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
