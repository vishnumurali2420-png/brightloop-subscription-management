<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled Action: Recurring Invoice Generation -->
        <record id="cron_recurring_subscription_billing" model="ir.cron">
            <field name="name">Brightloop: Recurring Subscription Billing Scheduler</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_recurring_invoices()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Scheduled Action: Expiry Reminders and Auto-Closure -->
        <record id="cron_subscription_expiry_reminder" model="ir.cron">
            <field name="name">Brightloop: Subscription Expiry Reminders &amp; Status Sync</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_expiries_and_reminders()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
